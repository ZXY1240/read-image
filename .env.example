READ_IMAGE_API_KEY=your-doubao-api-key
# Claude Code plugin sets READ_IMAGE_ENV_FILE automatically to plugin root/.env
# doubao | openai_compatible | auto
READ_IMAGE_PROVIDER=auto
READ_IMAGE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
READ_IMAGE_MODEL=doubao-seed-2-1-turbo-260628
# auto | thinking | enable_thinking | none
READ_IMAGE_OPENAI_THINKING_PARAM=auto
# JSON overrides for profile fields, e.g. {"quick":{"max_tokens":256}}
READ_IMAGE_PROFILES_JSON=
READ_IMAGE_CACHE_USE_TASK=1
READ_IMAGE_CACHE_TTL_SEC=300
READ_IMAGE_MAX_DIMENSION=2048
READ_IMAGE_FORMAT=auto
READ_IMAGE_JPEG_QUALITY=90
READ_IMAGE_EXTREME_ASPECT_RATIO_LIMIT=8
READ_IMAGE_TIMEOUT_SEC=60
READ_IMAGE_BATCH_WORKERS=4
READ_IMAGE_BATCH_TIMEOUT_SEC=300
READ_VIDEO_MAX_MB=50
READ_VIDEO_BASE64_MAX_MB=45
READ_VIDEO_DOWNLOAD_MAX_MB=512
READ_VIDEO_FILES_API_TIMEOUT_SEC=180
READ_VIDEO_KEEP_AUDIO=0
READ_VIDEO_TIMEOUT_SEC=300
READ_IMAGE_CACHE_MAX_ENTRIES=256
READ_IMAGE_LOG_LEVEL=INFO
READ_IMAGE_LANGUAGE=zh
READ_IMAGE_ALLOWED_OUTPUT_DIRS=
READ_IMAGE_ALLOW_PRIVATE_URLS=
READ_IMAGE_VIDEO_WORKERS=2
READ_VIDEO_WORKERS=2
READ_DRAG_WINDOW_MIN=30
READ_DRAG_PATTERNS=codex-clipboard-*,pasted_image*,current_paste*,pasted_*,claude-*,*.tmp
READ_DRAG_DIRS=
CAPTURE_PAGE_TIMEOUT_SEC=60
CAPTURE_PAGE_BROWSER=msedge
CAPTURE_PAGE_WAIT_UNTIL=domcontentloaded
CAPTURE_PAGE_SETTLE_MS=500
CAPTURE_PAGE_MAX_FULL_PAGE_HEIGHT=12000
WINDOWS_CAPTURE_DIR=

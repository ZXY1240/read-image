{
  "mcpServers": {
    "omnimodal-recognize": {
      "command": "uv",
      "args": [
        "run",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}",
        "omnimodal-recognize"
      ],
      "env": {
        "OMNIMODAL_ENV_FILE": "${CLAUDE_PLUGIN_ROOT}/.env"
      }
    },
    "omnimodal-capture-page": {
      "command": "uv",
      "args": [
        "run",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}",

      "env": {
        "OMNIMODAL_ENV_FILE": "${CLAUDE_PLUGIN_ROOT}/.env"
      }
    },
    "omnimodal-windows-capture": {
      "command": "uv",
      "args": [
        "run",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}",
        "omnimodal-windows-capture"
      ],
      "env": {
        "OMNIMODAL_ENV_FILE": "${CLAUDE_PLUGIN_ROOT}/.env"
      }
    },
    "omnimodal-generation": {
      "command": "uv",
      "args": [
        "run",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}",
